FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN npm install --global pnpm@9.15.9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.base.json ./
COPY artifacts/randomized-forms/package.json artifacts/randomized-forms/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json

RUN pnpm install --no-frozen-lockfile

COPY artifacts/randomized-forms artifacts/randomized-forms
COPY lib/api-client-react lib/api-client-react

ENV PORT=5173
ENV BASE_PATH=/
RUN pnpm --filter @workspace/randomized-forms run build

FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/artifacts/randomized-forms/dist/public /usr/share/nginx/html

EXPOSE 80